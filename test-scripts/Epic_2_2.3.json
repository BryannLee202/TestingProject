          "name": "POST /reviews",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 1. Kiểm tra Status Code (Chấp nhận 200/201 nếu đã mua, hoặc 400 nếu chưa mua)\r\npm.test(\"✅ Status code hợp lệ (200/201 hoặc 400)\", () => {\r\n    pm.expect(pm.response.code).to.be.oneOf([200, 201, 400]);\r\n});\r\n\r\n// 2. Kiểm tra thời gian phản hồi < 2s\r\npm.test(\"⏱ Response time < 2000ms\", () => {\r\n    pm.expect(pm.response.responseTime).to.be.below(2000);\r\n});\r\n\r\n// 3. Kiểm tra Response Body phù hợp theo từng trường hợp\r\npm.test(\"📦 Response body hợp lệ\", () => {\r\n    const json = pm.response.json();\r\n    if (pm.response.code === 200 || pm.response.code === 201) {\r\n        // Nếu đã mua hàng -> Phải có id và rating\r\n        pm.expect(json).to.have.property(\"id\");\r\n        pm.expect(json).to.have.property(\"rating\");\r\n        if (json.id) { pm.environment.set(\"reviewId\", json.id); }\r\n    } else {\r\n        // Nếu chưa mua hàng (400) -> Phải có thông báo lỗi\r\n        pm.expect(json).to.have.property(\"message\");\r\n    }\r\n});\r\n"
                ]
              }
            }
          ],
