  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code là 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response time < 2000ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});",
                  "",
                  "pm.test(\"Body có token\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"token\");",
                  "    pm.expect(json.token).to.be.a(\"string\").and.to.not.be.empty;",
                  "});",
                  "",
                  "pm.test(\"Lưu biến môi trường token\", function () {",
                  "    pm.environment.set(\"token\", pm.response.json().token);",
                  "    pm.expect(pm.environment.get(\"token\")).to.not.be.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Phu Test User\",\n  \"email\": \"{{phuTestEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"phone\": \"0123456789\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"phuTestEmail\", \"phu_test_\" + Date.now() + \"@example.com\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code là 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response time < 2000ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});",
                  "",
                  "pm.test(\"Body có token của tài khoản vừa tạo\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"token\");",
                  "    pm.expect(json.token).to.be.a(\"string\").and.to.not.be.empty;",
                  "});",
                  "",
                  "pm.test(\"Backend lưu đúng name của tài khoản vừa tạo\", function () {",
                  "    pm.expect(pm.response.json().user.name).to.eql(\"Phu Test User\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
