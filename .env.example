# Copy this file to ".env" (same folder as docker-compose.yml), fill in real
# values, then `docker compose up` picks them up automatically. This file is
# already covered by .gitignore's bare ".env" pattern - safe to put real
# secrets in your own local ".env", never commit it.
#
# Everything below is OPTIONAL. The app runs fine with none of this set -
# only Google/Apple login and OTP emails (registration, forgot-password)
# stay disabled until you fill these in.
#
# NEVER commit a real .env. Get real values from whoever already has access
# (Firebase Console / Brevo dashboard) rather than creating unrelated ones -
# the frontend is hardwired to one specific Firebase project (yiyi-bookstore),
# so a service account from a different project will not work.

# --- Firebase (enables Google/Apple login) ---
# Paste the ENTIRE service-account JSON as ONE line. Get it from Firebase
# Console -> Project Settings -> Service Accounts -> yiyi-bookstore project
# -> Generate new private key.
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Email for OTP (enables registration + forgot-password) ---
# Recommended: Brevo API key (free tier at brevo.com, works from anywhere
# including Docker - no SMTP blocking issues). Takes priority if set.
BREVO_API_KEY=

# Alternative to Brevo: Gmail SMTP app password (needs 2FA enabled on the
# Gmail account; generate at https://myaccount.google.com/apppasswords).
# Only used as a fallback when BREVO_API_KEY above is blank.
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
