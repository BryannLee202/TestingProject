# =============================================================================
# YiYi Book backend — environment variable reference
# =============================================================================
# IMPORTANT: Spring Boot does NOT read a .env file by itself. This file only
# documents every variable the app looks for (via ${VAR:default} placeholders
# in application*.properties and @Value annotations in the Java code). To
# actually apply these values locally, pick ONE of:
#
#   A) Copy application-local.properties.example -> application-local.properties
#      (in backend/src/main/resources/), fill in real values, then run:
#        ./mvnw spring-boot:run -Dspring-boot.run.profiles=local
#      This is the native Spring Boot way and needs no extra dependency.
#
#   B) Export these as real OS environment variables before starting the app
#      (see README "Chạy Backend" section for PowerShell examples), then run
#      the default profile: ./mvnw spring-boot:run
#
#   C) If you prefer an actual `.env` file loader, add the dependency
#      `me.paulschwarz:spring-dotenv` to pom.xml — then this file (renamed to
#      `.env`, placed in backend/) will be picked up automatically.
#
# NEVER commit a real, filled-in .env or application-local.properties — both
# are already covered by backend/.gitignore patterns (verify before pushing).
# =============================================================================

# --- Server -------------------------------------------------------------
PORT=8081
FRONTEND_URL=http://localhost:5173

# --- Database (choose MySQL, matches application-prod.properties) -------
# Uses your existing local MySQL80 service (MySQL Workbench) on port 3306.
# Run backend/local-db-setup.sql once in Workbench to create the DB + user.
MYSQLHOST=localhost
MYSQLPORT=3306
MYSQLDATABASE=bookstore
MYSQLUSER=bookstore_user
MYSQLPASSWORD=bookstore_pass

# --- JWT ------------------------------------------------------------------
# MUST be valid Base64 (JwtService.java does Decoders.BASE64.decode on it) —
# a hex string or arbitrary text will crash login with "Illegal base64
# character". Generate your own with: openssl rand -base64 32
APPLICATION_SECURITY_JWT_SECRET_KEY=RuggnlTq6FX/AsZH00G51T/8FVRpk6JpXB2Sj0YG94M=
APPLICATION_SECURITY_JWT_EXPIRATION=86400000

# --- Email (OTP / notifications) — via Brevo API (see EmailService.java) --
BREVO_API_KEY=
SPRING_MAIL_USERNAME=noreply@yiyibook.vn

# --- Firebase Admin SDK (Google/Apple social login) ------------------------
# Paste the ENTIRE contents of your Firebase service-account JSON as one line,
# OR skip this and drop the file directly at
# backend/src/main/resources/serviceAccountKey.json (used as local fallback,
# see FirebaseConfig.java) — social login just won't work without one or the
# other, everything else runs fine.
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Payment gateways -------------------------------------------------------
# NOTE: as of this writing, VNPay/MoMo/ZaloPay credentials are HARDCODED
# (sandbox test keys) in config/VNPayConfig.java, config/MoMoConfig.java and
# config/ZaloPayConfig.java — they do NOT actually read these env vars yet.
# Listed here for documentation/reference if you refactor them to @Value.
VNPAY_TMN_CODE=CGXZLS0Z
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=${FRONTEND_URL}/payment/vnpay-return
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
